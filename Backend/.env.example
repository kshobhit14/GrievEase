PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/grievease
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ML_SERVICE_URL=http://127.0.0.1:5000
FRONTEND_URL=http://localhost:5173
# Set these temporarily when running: npm run seed:admin
ADMIN_NAME=Academic Block Admin
ADMIN_EMAIL=academic.admin@example.edu
ADMIN_PASSWORD=use_a_unique_long_password
ADMIN_STATION=Academic Block
# Use main_admin for the single main admin; leave ADMIN_STATION blank for it.
ADMIN_ROLE=admin
# Bulk setup: npm run seed:admins
ADMIN_DEFAULT_PASSWORD=use_a_unique_long_password
MAIN_ADMIN_NAME=Main Admin
MAIN_ADMIN_EMAIL=mainadmin@college.edu
# Optional credential sync: npm run sync:admins
MAIN_ADMIN_PASSWORD=change_me
ACADEMIC_BLOCK_ADMIN_PASSWORD=change_me
CLASSROOM_ADMIN_PASSWORD=change_me
MAIN_GATE_ADMIN_PASSWORD=change_me
LIBRARY_ADMIN_PASSWORD=change_me
HOSTEL_ADMIN_PASSWORD=change_me
PEDESTRIAN_ADMIN_PASSWORD=change_me
OTHER_ISSUES_ADMIN_PASSWORD=change_me
